# Configuration Git locale du projet
# (git config --local, appliqué automatiquement par tools/setup-git.mjs)

[core]
	# Les fins de ligne sont normalisées par .gitattributes.
	autocrlf = false
	# Les fichiers non texte sont détectés automatiquement.
	safecrlf = warn
	# compression des objets lors de l'empaquetage
	compression = 2

[init]
	defaultBranch = main

[branch]
	# Rebaser plutôt que créer des commits de fusion.
	rebase = true

[merge]
	conflictstyle = zdiff3

[diff]
	# Les réorganisations de code sont plus faciles à lire.
	renames = copies
	algorithm = histogram

[push]
	default = current
	followTags = true

[tag]
	sort = version:refname

[fetch]
	prune = true
	pruneTags = true

[rerere]
	enabled = true
	autoupdate = true

[help]
	autocorrect = prompt
