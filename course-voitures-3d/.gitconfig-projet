# Configuration Git locale du projet
# (git config --local, appliquée automatiquement par tools/setup-git.mjs)
#
# Ces valeurs sont des VALEURS PAR DÉFAUT : setup-git.mjs n'écrase jamais un
# réglage déjà présent dans .git/config. Relancer le script sur un dépôt
# configuré ne change donc rien ; sur un dépôt neuf, il applique ce fichier.

[core]
	# Les fins de ligne sont normalisées par .gitattributes.
	autocrlf = false
	# Les fichiers non texte sont détectés automatiquement.
	safecrlf = warn
	# compression des objets lors de l'empaquetage
	compression = 2

[init]
	defaultBranch = main

[branch]
	# Rebaser plutôt que créer des commits de fusion.
	rebase = true

[merge]
	conflictstyle = zdiff3

[diff]
	# Les réorganisations de code sont plus faciles à lire.
	renames = copies
	algorithm = histogram

[push]
	default = current
	followTags = true

[tag]
	sort = version:refname

[fetch]
	prune = true
	pruneTags = true

[rerere]
	enabled = true
	autoupdate = true

[help]
	autocorrect = prompt
