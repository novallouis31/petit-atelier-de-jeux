# Normalisation des fins de ligne
* text=auto eol=lf

# Textes
*.js   text diff=javascript
*.mjs  text diff=javascript
*.json text
*.css  text
*.html text
*.md   text
*.txt  text

# Scripts Windows : cmd.exe attend des fins de ligne CRLF, sinon les blocs
# multi-lignes (if ... ( ... )) peuvent être mal interprétés.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binaires
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.glb  binary
*.gltf binary
*.hdr  binary
*.exr  binary
